// GetBooqin Core — the standalone backend and system of record for the
// booking workflow (Booking, Resource, Schedule, TimeOff, Customer, Payment,
// Addon, ChatConversation). Bootstrapped from shopify-openslot's schema;
// see docs/plan/tenant-session-design.md for why this split exists.
//
// Every tenant-scoped table carries both `shop` (the store's identifier on
// its platform — a *.myshopify.com domain today) and `platform` (default
// "shopify") so a second platform is additive later, not a migration. Catalog
// data (product name/price/description) is NOT modeled as editable state —
// it stays owned by the platform; GetBooqin only stores booking config
// (ServiceConfig) and a read-through cache (ProductCache).
//
// Money fields are Float, carried over as-is from shopify-openslot — see
// that repo's schema.prisma for the Decimal migration note; the same
// caveat applies here once payments are wired up.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Shopify session storage (required by @shopify/shopify-app-react-router,
// used by shopify-openslot's embedded admin via PrismaSessionStorage) ---
// Single-platform by nature (Shopify's own OAuth session shape) — no
// `platform` column, unlike the tenant-scoped models below.

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// --- Standalone identity: users and their linked platform stores ---

// id is Clerk's own user id (e.g. "user_xxx") — Clerk owns identity/auth,
// this row just mirrors it for Connection to key off. Kept in sync by
// cloud/app/routes/webhooks.clerk.tsx on user.created/user.updated.
model User {
  id                String             @id
  email             String             @unique
  // The merchant's own contact number. Ours alone: Clerk never sees it,
  // so this row is the only copy.
  //
  // Not a temporary workaround — a decision, re-confirmed 10-01-2026.
  // Putting it in Clerk needs phone enabled as an identifier, and that
  // (like the SMS country allowlist, which blocks +91 by default) is a
  // paid Clerk feature; we are on the free tier. Clerk's Backend API
  // `createPhoneNumber({ verified: true })` sends no SMS and might slip
  // past that gate, but it is untested here and nothing depends on it.
  //
  // Unverified by design, and that is the point: nobody signs in with
  // this, so there is no credential to verify. If it is ever promoted to
  // a recovery channel or a second factor, it has to be verified for
  // real first.
  //
  // Written by cloud/app/routes/dashboard.profile-phone.tsx (canonical
  // form, no country code inferred) and backfilled by onboarding's step 1
  // for the Google sign-up path, which never reaches that route.
  phone             String             @default("")
  /// The mailbox this address actually reaches, for duplicate detection
  /// only — never for sending. `info.scintillaweb@gmail.com` and
  /// `info.scintilla.web@gmail.com` are one inbox, and left alone that
  /// is a free duplicate-account generator: one person, two trials, two
  /// booking pages, and then "where did my appointments go?".
  ///
  /// Indexed rather than unique. Existing accounts may already have
  /// collided, and a unique constraint would refuse the migration over
  /// data we would then have to merge by hand. The check happens at
  /// signup, where it can explain itself.
  ///
  /// See auth/emailIdentity.ts — the SQL backfill in the migration
  /// mirrors that function exactly.
  emailKey          String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Platform-admin flag for the internal /admin console (§W8). Layered,
  // never clever: this column AND the email appearing in the
  // PLATFORM_ADMIN_EMAILS env allowlist are both required, so a leaked
  // session or a bad write to one is not enough on its own, and the env
  // var is what bootstraps the very first admin.
  isPlatformAdmin   Boolean            @default(false)
  connections       Connection[]
  connectionMembers ConnectionMember[]
  adminActions      AdminAuditLog[]

  @@index([emailKey])
}

// One store a User has linked. `credentials` holds whatever the platform's
// auth flow hands back (a Shopify offline access token today) encrypted at
// rest — see src/auth/encryption.ts. A (platform, shop) pair can only ever
// belong to one User: reconnecting the same store from a different User
// must be rejected or made an explicit transfer, never a silent duplicate.
model Connection {
  id              String             @id @default(cuid())
  userId          String
  platform        String             @default("shopify")
  shop            String
  credentials     String
  status          String             @default("active") // active|revoked|error
  connectedAt     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  // Human-readable alias for the public /book/:connectionId link (UX
  // audit's #13 finding — a raw cuid is unfriendly in a social bio). Null
  // until Connections.ensureSlug() generates one lazily; the cuid `id`
  // keeps resolving permanently either way, so an already-shared link never
  // breaks.
  slug            String?            @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         ConnectionMember[]
  invites         ConnectionInvite[]
  subscription    Subscription?
  entitlements    Entitlement[]
  billingEvents   BillingEvent[]
  lifecycleEmails LifecycleEmail[]
  invoices        Invoice[]
  whatsapp        WhatsAppAccount?

  @@unique([platform, shop])
  @@index([userId])
}

// One row per user granted access to a Connection — the multi-user team
// model. The Connection's own `userId` remains the implicit "owner" (see
// the Connection model comment); this table is what "list team members"
// and requireTenant's role check actually query, so the owner also gets an
// explicit row here (role "owner", backfilled by this model's migration)
// rather than requiring every membership check to UNION against
// Connection.userId separately. See core/src/team.ts for the CRUD/role
// logic this backs.
model ConnectionMember {
  id              String     @id @default(cuid())
  connectionId    String
  userId          String
  role            String     @default("read") // owner|admin|write|read
  invitedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectionId, userId])
  @@index([userId])
}

// A pending (or resolved) email invitation onto a Connection's team.
// Deliberately not FK'd to User — the invited person may not have an
// account yet. `token` is a signPayload()-produced string
// (core/src/auth/session.ts); acceptInvite() looks the row up by this
// exact column, not by re-decoding whatever token is presented, so
// resending (which overwrites `token` in place — see the
// `[connectionId, email]` unique constraint) naturally invalidates the
// previously emailed link: it just no longer matches any row.
model ConnectionInvite {
  id              String     @id @default(cuid())
  connectionId    String
  email           String
  role            String     @default("write") // admin|write|read — never "owner"
  token           String     @unique
  status          String     @default("pending") // pending|accepted|revoked|expired
  invitedByUserId String
  createdAt       DateTime   @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, email])
  @@index([connectionId, status])
}

// --- Per-shop settings ---

// Phase 0 / B1 — bookkeeping for the scheduled jobs an external scheduler
// drives (today: the hourly /cron/reminders sweep).
//
// Nothing in the repo scheduled that sweep at all, so reminders — a
// feature listed on every pricing tier — simply never fired in production.
// A schedule alone doesn't fix that, because a schedule that silently
// stops looks exactly like a schedule that's working: no reminders is the
// normal state most hours. This table is what makes the difference
// observable. One row per job, upserted on every run, whether it succeeded
// or threw.
//
// Read by the platform admin console's "last run" tile (§W8) and by
// Jobs.staleJobs() for a health check. `name` is the primary key — there
// is exactly one current state per job, not a log; a run history, if it's
// ever wanted, is a separate table rather than an unbounded growth of this
// one.
model JobRun {
  name String @id // "reminders"

  // Every attempt updates this, successful or not — it is the "is the
  // scheduler alive at all" signal, and is deliberately separate from
  // lastSuccessAt so a job that runs and fails every hour reads as broken
  // rather than as absent.
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  // Truncated message from the most recent failure, cleared on the next
  // success. Never a stack trace: this is rendered in an admin UI.
  lastError String?

  // Whatever the job wants to report about its last successful run, as
  // JSON — `{"reminders_sent":4,"conversations_deleted":0}` for the
  // reminders sweep. Display only; nothing parses it for control flow.
  lastResult String?

  runCount     Int @default(0)
  failureCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopSettings {
  shop      String
  platform  String   @default("shopify")
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([platform, shop])
}

// --- Catalogue ---
// Prompt 4 catch-up: brought into line with shopify-openslot's Prompt 3
// refactor. The platform product is the source of truth for catalogue
// fields (name/price/category/description) — never duplicated here as
// editable state, only cached (ProductCache). ServiceConfig owns booking
// config only, 1:1 with a product via productId. Kept in sync with the
// product's `getbooqin` metafield namespace both ways where the platform
// supports it (see src/platforms/shopifyAdmin.ts).

model ServiceConfig {
  id                           Int               @id @default(autoincrement())
  shop                         String
  platform                     String            @default("shopify")
  productId                    String
  productHandle                String
  durationMin                  Int               @default(30)
  bufferBeforeMin              Int               @default(0)
  bufferAfterMin               Int               @default(0)
  capacity                     Int               @default(1)
  locationType                 String            @default("onsite") // onsite | video | phone
  // Deposit policy for this service. Dormant since the gateway code was
  // cut; the fields survived because tables were left alone.
  //
  //   paymentRequired false  -> nothing is owed at booking time
  //   depositAmount   > 0    -> that fixed amount
  //   depositPercent  1-99   -> that share of the price
  //   depositPercent  100    -> the full price
  //
  // Fixed wins over percent when both are set: a merchant who typed an
  // amount meant the amount.
  paymentRequired              Boolean           @default(false)
  depositPercent               Int               @default(100)
  depositAmount                Float             @default(0)
  // Storefront services-grid swatch colour — a GetBooqin-only display
  // preference, not a platform product concept, so unlike the rest of
  // ServiceConfig this is plain local state, not synced via metafields.
  color                        String            @default("#2563eb")
  position                     Int               @default(0)
  status                       Boolean           @default(true)
  // True once a merchant has ever explicitly saved this service's resource
  // assignment (even to zero resources) — resourcesForService() needs this
  // to tell "never configured, fall back to everyone" apart from "assigned
  // to nobody on purpose", which used to be indistinguishable and silently
  // reversed an intentional "nobody" choice (Defect Dossier's BQ-05
  // finding).
  resourceAssignmentCustomized Boolean           @default(false)
  // Off by default — no existing service starts requiring a room it never
  // needed. When on, the slot engine and Bookings.create()/reschedule()
  // also need a free room (drawn from this service's own ServiceResource
  // links to a kind: "room" Resource, same join table practitioners use)
  // before offering or accepting a time, so two practitioners can no longer
  // be booked into the same physical chair at once (GetBooqin clinic
  // audit's RS-01 finding).
  requiresRoom                 Boolean           @default(false)
  // Set instead of a hard delete when a booking still references this
  // service — the row (and its productId, so historical bookings can still
  // resolve a name) has to survive, but it must disappear from every active
  // list: the services page, the public page, the Add-consultation dialog
  // (Defect Dossier's BQ-32 finding). Distinct from `status`, which a
  // merchant can flip back on; this can't be undone from the UI.
  deletedAt                    DateTime?
  // Last product `updated_at` this row was synced from — lets a future
  // webhook/sync cheaply skip an out-of-order/duplicate delivery.
  platformUpdatedAt            DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  resourceLinks                ServiceResource[]
  addonLinks                   ServiceAddon[]
  bookings                     Booking[]
  waitlistEntries              Waitlist[]

  @@unique([platform, shop, productId])
  @@index([platform, shop, status, position])
  @@index([platform, shop, productHandle])
}

// Read-only reference cache of a platform product's catalogue fields —
// refreshed by src/platforms/shopifyAdmin.ts's syncProductsFromShopify,
// never edited directly.
model ProductCache {
  id            Int      @id @default(autoincrement())
  shop          String
  platform      String   @default("shopify")
  productId     String
  productHandle String
  title         String   @default("")
  description   String   @default("")
  category      String   @default("")
  image         String   @default("")
  price         Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([platform, shop, productId])
  @@index([platform, shop, productHandle])
}

// "kind" turns this one table into two bookable dimensions instead of a
// second model — a room needs exactly the same things a practitioner
// already has (a name, its own weekly hours via Schedule, its own time off
// via TimeOff, and a place in a service's ServiceResource assignment list),
// just none of the practitioner-only fields (email/phone/meetingLink stay
// on the row but are blank and hidden in the room editor). Defaults to
// "practitioner" so every existing row is unaffected (GetBooqin clinic
// audit's RS-01 finding: "Practitioners & rooms" promised a resource type
// that didn't exist — two practitioners could be booked into the same
// physical chair at once, since nothing tracked chair occupancy at all).
model Resource {
  id           Int               @id @default(autoincrement())
  shop         String
  platform     String            @default("shopify")
  kind         String            @default("practitioner") // practitioner | room
  name         String
  title        String            @default("")
  email        String            @default("")
  phone        String            @default("")
  description  String?
  avatarUrl    String            @default("")
  meetingLink  String            @default("")
  timezone     String            @default("")
  position     Int               @default(0)
  status       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  serviceLinks ServiceResource[]
  schedules    Schedule[]
  bookings     Booking[]         @relation("BookingPractitioner")
  roomBookings Booking[]         @relation("BookingRoom")

  @@index([platform, shop, status, position])
  @@index([platform, shop, kind, status, position])
}

model ServiceResource {
  id               Int           @id @default(autoincrement())
  shop             String
  platform         String        @default("shopify")
  serviceId        Int
  resourceId       Int
  priceOverride    Float?
  durationOverride Int?
  service          ServiceConfig @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource         Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceId])
  @@index([platform, shop, resourceId])
}

model Addon {
  id           Int            @id @default(autoincrement())
  shop         String
  platform     String         @default("shopify")
  name         String
  description  String?
  price        Float          @default(0)
  durationMin  Int            @default(0)
  position     Int            @default(0)
  status       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  serviceLinks ServiceAddon[]
  bookingLinks BookingAddon[]

  @@index([platform, shop, status, position])
}

model ServiceAddon {
  id        Int           @id @default(autoincrement())
  shop      String
  platform  String        @default("shopify")
  serviceId Int
  addonId   Int
  service   ServiceConfig @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  addon     Addon         @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([serviceId, addonId])
  @@index([platform, shop, addonId])
}

model Schedule {
  id         Int      @id @default(autoincrement())
  shop       String
  platform   String   @default("shopify")
  resourceId Int
  dayOfWeek  Int // 0 (Sun) - 6 (Sat)
  startTime  String // "HH:MM"
  endTime    String // "HH:MM"
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([platform, shop, resourceId, dayOfWeek])
}

// resourceId = 0 means "whole business", same convention as shopify-openslot.
model TimeOff {
  id         Int      @id @default(autoincrement())
  shop       String
  platform   String   @default("shopify")
  resourceId Int      @default(0)
  startUtc   DateTime
  endUtc     DateTime
  reason     String   @default("")
  createdAt  DateTime @default(now())

  @@index([platform, shop, resourceId, startUtc, endUtc])
}

model Customer {
  id                  Int        @id @default(autoincrement())
  shop                String
  platform            String     @default("shopify")
  firstName           String     @default("")
  lastName            String     @default("")
  email               String
  phone               String     @default("")
  timezone            String     @default("")
  notes               String?
  // A dental record isn't a customer record — a patient's date of birth
  // and any medical alert (allergy, condition, anything staff need to see
  // before an appointment) had nowhere to live at all before this, and a
  // mistyped contact detail could only be fixed by erasing and re-creating
  // the whole record (GetBooqin clinic audit's PT-02 finding). Both blank
  // by default and shown nowhere unless filled in — no existing shop's
  // customer records change.
  dateOfBirth         String?
  medicalAlert        String     @default("")
  /// WhatsApp opt-in. Meta requires demonstrable consent before a
  /// business sends a customer a template message, and "demonstrable"
  /// means being able to say when and where it was given — so this is
  /// three columns rather than a boolean. Default false: an existing
  /// customer who gave an email address years ago did not consent to
  /// this, and backfilling them to true would be the exact thing the
  /// rule exists to prevent.
  whatsappOptIn       Boolean    @default(false)
  whatsappOptInAt     DateTime?
  /// Where consent came from — "booking_form", "dashboard", "import".
  whatsappOptInSource String     @default("")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bookings            Booking[]
  waitlistEntries     Waitlist[]

  @@unique([platform, shop, email])
}

model Booking {
  id              Int      @id @default(autoincrement())
  shop            String
  platform        String   @default("shopify")
  uid             String   @unique
  serviceId       Int
  resourceId      Int
  // Set only when the service delivering this booking has requiresRoom on
  // — null for the overwhelming majority of bookings, at every shop that
  // never turned rooms on at all. Occupies the room exactly like
  // resourceId occupies the practitioner: Availability.hasRoomConflict()
  // checks this column, not resourceId, so a room and its assigned
  // practitioner are two independently double-booking-checked resources
  // sharing one time slot (GetBooqin clinic audit's RS-01 finding).
  roomId          Int?
  customerId      Int
  startUtc        DateTime
  endUtc          DateTime
  timezone        String   @default("UTC")
  status          String   @default("pending") // pending|confirmed|cancelled|completed|no_show
  price           Float    @default(0)
  amountDue       Float    @default(0)
  currency        String   @default("USD")
  paymentStatus   String   @default("not_required") // not_required|unpaid|paid|refunded|failed
  meetingProvider String   @default("")
  meetingUrl      String   @default("")
  meetingId       String   @default("")
  notes           String?
  customFields    String?
  source          String   @default("form") // form|chat|waitlist
  reminderSent    Boolean  @default(false)
  // Does this booking hold its practitioner for its whole time range, or
  // share the slot with others? Denormalised from the service's `capacity`
  // at write time (capacity 1 -> true, group/class/cohort services ->
  // false) purely so the `Booking_resource_no_overlap` exclusion constraint
  // can tell the two apart — a constraint predicate can't reach into
  // ServiceConfig. Kept in step by Data.saveServiceConfig(), which resyncs
  // future bookings whenever a service's capacity crosses the 1 boundary.
  //
  // The two EXCLUDE USING gist constraints this backs are raw SQL (see
  // migrations/20260912090000_booking_overlap_exclusion) — Prisma has no
  // schema syntax for exclusion constraints, so they exist in the database
  // but not in this file. `prisma migrate dev` will not try to drop them;
  // `prisma db push` would. Don't use db push on this schema.
  exclusive       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service               ServiceConfig         @relation(fields: [serviceId], references: [id])
  resource              Resource              @relation("BookingPractitioner", fields: [resourceId], references: [id])
  room                  Resource?             @relation("BookingRoom", fields: [roomId], references: [id])
  customer              Customer              @relation(fields: [customerId], references: [id])
  payments              Payment[]
  addons                BookingAddon[]
  consultationSummaries ConsultationSummary[]

  @@index([platform, shop, resourceId, startUtc, status])
  @@index([platform, shop, roomId, startUtc, status])
  @@index([platform, shop, customerId, startUtc])
  @@index([platform, shop, status, startUtc])
  @@index([platform, shop, reminderSent, startUtc])
  @@index([platform, shop, paymentStatus])
}

model BookingAddon {
  id          Int     @id @default(autoincrement())
  shop        String
  platform    String  @default("shopify")
  bookingId   Int
  addonId     Int
  name        String
  price       Float   @default(0)
  durationMin Int     @default(0)
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addon       Addon   @relation(fields: [addonId], references: [id])

  @@index([platform, shop, bookingId])
}

// Visit Summary feature (Clinic preset only — see
// docs/patient-summary-cloud-integration-plan.md). One row per generated
// summary draft/revision for a completed Booking. `draftJson` is the raw,
// immutable LLM output (core/src/ai/patientSummary.ts); `editedJson` starts
// as a copy of it and diverges as the reviewing clinician edits fields —
// kept separate so "AI-drafted" vs "Edited by Dr. X" and "Revert to AI
// draft" don't require re-calling the model. See
// core/src/booking/consultationSummary.ts for the state machine this backs
// (draft -> under_review -> approved -> sent, discard from any pre-sent
// state, createRevision() for post-send corrections).
model ConsultationSummary {
  id       Int    @id @default(autoincrement())
  shop     String
  platform String @default("shopify")

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status String @default("draft") // draft|under_review|approved|sent|discarded

  transcriptText   String
  transcriptSource String @default("paste") // paste|upload|record

  outputLanguage   String
  detectedLanguage String?

  // Raw LLM output, immutable once written (a regenerate() replaces both
  // this and editedJson wholesale, it never patches in place). JSON-encoded
  // PatientSummaryDraft (core/src/ai/patientSummary.ts).
  draftJson  String
  // Clinician-edited version actually rendered/sent — starts equal to
  // draftJson, diverges field by field as edits happen. This is what the
  // patient-facing page/email renders once sent.
  editedJson String

  // JSON array of acknowledged review_flags (indices or the flag strings
  // themselves) — approve() requires this to cover every entry in the
  // draft's review_flags before the status can move to "approved".
  reviewFlagsAcknowledged String @default("[]")

  // Attestation captured by approve() — see Part 3 §4 of the integration
  // plan on why this can't be inferred from session identity yet (no
  // per-staff login). Plain FK-by-convention, no Prisma relation, same
  // convention as Waitlist.resultingBookingId / ChatConversation.bookingId.
  approvedByResourceId Int?
  approvedAt           DateTime?

  sentAt DateTime?

  // Self-relation for post-send corrections: createRevision() creates a new
  // row seeded from the sent row's editedJson (not a fresh LLM call) with
  // revisionOfId pointing back at it. The sent row itself stays immutable.
  revisionOfId Int?
  revisionOf   ConsultationSummary?  @relation("ConsultationSummaryRevision", fields: [revisionOfId], references: [id])
  revisions    ConsultationSummary[] @relation("ConsultationSummaryRevision")

  // Bounded retention for the raw transcript (see the integration plan's
  // Retention section) — a future cron sweep purges transcriptText once
  // past this. Concrete window is a legal/product decision, not set here.
  retentionExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform, shop, bookingId])
  @@index([platform, shop, status])
  @@index([platform, shop, revisionOfId])
}

// Waitlist entries are matched by service (+ optional specific resource) and
// a preferred date window, not a specific slot — the specific slot only
// exists once a cancellation actually offers one (offeredResourceId/
// offeredStartUtc/offeredEndUtc + a time-boxed offerExpiresAt). Deliberately
// not a Booking row until claim() actually creates one — see
// core/src/booking/waitlist.ts.
model Waitlist {
  id       Int    @id @default(autoincrement())
  shop     String
  platform String @default("shopify")
  uid      String @unique

  serviceId  Int
  resourceId Int @default(0) // 0 = any resource for this service — same sentinel as TimeOff.resourceId
  customerId Int

  windowStartUtc DateTime
  windowEndUtc   DateTime?
  notes          String    @default("")

  status String @default("waiting") // waiting|offered|claimed|expired|cancelled

  offerToken        String?   @unique
  offeredResourceId Int?
  offeredStartUtc   DateTime?
  offeredEndUtc     DateTime?
  offerExpiresAt    DateTime?
  offerCount        Int       @default(0)

  resultingBookingId Int @default(0) // set once claimed — plain FK-by-convention, no Prisma relation (same as ChatConversation.bookingId)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service  ServiceConfig @relation(fields: [serviceId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  // Also has a partial unique index -- (platform, shop, serviceId, resourceId,
  // windowStartUtc, customerId) WHERE status IN ('waiting','offered') --
  // hand-written in migrations/20260903140000_waitlist_dedupe_active_joins
  // since Prisma's DSL can't express a filtered unique index.

  @@index([platform, shop, serviceId, resourceId, status, createdAt])
  @@index([platform, shop, status, offerExpiresAt])
  @@index([platform, shop, customerId, status])
}

/// One payment asked for against a booking, and whether it arrived.
///
/// A *request*, not a gateway transaction — that is the difference from
/// what this table was originally written for. GetBooqin never touches
/// the money: the merchant supplies a UPI ID or a PayPal.me handle, we
/// render a link and a QR the customer pays through directly, and the
/// merchant confirms it. There is no provider to ask and no webhook to
/// wait for, so `status` is the merchant's own assertion rather than
/// something verified.
///
/// Shaped so that can stop being true without a rewrite: the day a
/// merchant connects their own Razorpay key, `link` becomes a Payment
/// Link, `transactionId` holds the provider's payment id, and a webhook
/// sets `status` instead of a person. The policy, the screens and the
/// emails around it do not change.
model Payment {
  id        Int    @id @default(autoincrement())
  shop      String
  platform  String @default("shopify")
  bookingId Int

  /// deposit|balance|full — what this request is for.
  kind      String @default("deposit")
  /// upi|paypal|cash|bank|other — how the customer was asked to pay.
  method    String @default("upi")
  /// Short human reference, shown to both sides and carried in the UPI
  /// link, so a line on a bank statement can be matched to a booking.
  reference String @default("")
  /// The upi:// or paypal.me link the customer was given. Stored rather
  /// than rebuilt, so resending cannot quietly change the amount or the
  /// payee after the fact.
  link      String @default("")

  /// Retained for a future provider-backed payment. Empty for a request
  /// a merchant confirmed by hand.
  gateway       String @default("")
  transactionId String @default("")
  /// The UTR the customer quoted. Evidence, not proof — it is what the
  /// merchant matches against their statement.
  utr           String @default("")

  amount            Float     @default(0)
  currency          String    @default("USD")
  /// pending|paid|cancelled|refunded
  status            String    @default("pending")
  /// Who marked it paid. Null when nobody has.
  confirmedByUserId String?
  paidAt            DateTime?

  payload   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([platform, shop, bookingId])
  @@index([platform, shop, status])
  @@index([platform, shop, gateway, transactionId])
}

model Faq {
  id       Int     @id @default(autoincrement())
  shop     String
  platform String  @default("shopify")
  question String
  answer   String?
  keywords String  @default("")
  position Int     @default(0)
  status   Boolean @default(true)

  @@index([platform, shop, status, position])
}

model ChatConversation {
  id           Int           @id @default(autoincrement())
  shop         String
  platform     String        @default("shopify")
  uid          String        @unique
  visitorName  String        @default("")
  visitorEmail String        @default("")
  visitorPhone String        @default("")
  state        String? // JSON — { step, data, ui }
  status       String        @default("open") // open|booked
  bookingId    Int           @default(0)
  pageUrl      String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@index([platform, shop, status, updatedAt])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  sender         String           @default("bot") // bot|visitor
  body           String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
}

// --- Billing (§W7) ---------------------------------------------------
//
// One subscription per Connection — a "business", which is the thing a
// merchant actually pays for, not a User (who may own several) and not a
// shop (which is a platform's name for the same business).
//
// **Written by exactly one code path: the webhook handler.** Checkout
// success pages never write subscription state; they redirect and let the
// webhook be the truth. That is the single most common way billing
// integrations go wrong, and the reason this comment is here rather than
// in a design doc.
//
// Money is stored in **minor units as Int** (paise for INR, cents for
// USD/EUR) — deliberately not the Float the booking tables use for
// prices. A rounding error on a merchant's own price list is a cosmetic
// bug; one on an invoice is a chargeback.
model Subscription {
  id           String @id @default(cuid())
  connectionId String @unique

  // free|starter|growth|business — see core/src/billing/plans.ts. Never an
  // enum: a plan table that can gain a tier without a migration is the
  // whole point of keeping plans.ts a plain data file.
  plan   String @default("free")
  // trialing|active|past_due|canceled|free
  status String @default("trialing")

  // Null once the trial has been resolved one way or the other. Expiry is
  // evaluated lazily inside entitlementsFor() rather than by a nightly
  // job — there is no scheduler to fail, and an account that nobody looks
  // at does not need its trial expired in the database to be correct.
  trialEndsAt DateTime?

  // paypal|razorpay|manual. Set at first upgrade and **never changed for
  // a live subscription**: migrating a mandate between providers means
  // cancel-and-re-authorise, which loses people. "manual" is an admin
  // grant with no money moving.
  billingProvider String @default("manual")

  // The currency this subscription actually bills in — INR via Razorpay,
  // USD or EUR via PayPal. Stored rather than re-derived from the
  // account's country, which can change after the mandate exists.
  currency     String @default("USD")
  // monthly|yearly
  billingCycle String @default("monthly")

  // --- Tax identity -------------------------------------------------
  // GetBooqin sells from an Indian registered entity, so there are
  // exactly two treatments and which one applies is decided by where
  // the customer is:
  //
  //   india_gst          — a domestic sale. Indian GST applies.
  //                        `taxId` is the customer's GSTIN when they
  //                        have one (a business claiming input credit);
  //                        blank is legitimate for an unregistered one.
  //   export_zero_rated  — a customer outside India. Export of services
  //                        is zero-rated under Indian GST, and for an EU
  //                        business the reverse charge makes it their
  //                        VAT to account for, not ours. `taxId` is
  //                        their VAT/business number and is **required**:
  //                        it is the evidence that this is a B2B export
  //                        rather than a consumer sale, which is what
  //                        keeps us out of EU OSS registration.
  //
  // ISO-3166 alpha-2, captured at checkout rather than derived — the
  // billing currency is a guess from settings, and a tax position must
  // not rest on a guess.
  taxCountry String @default("")
  taxId      String @default("")
  taxStatus  String @default("")

  // Who the invoice is made out to, and where they are. Captured at
  // checkout beside the tax identity rather than derived from
  // settings.business_name, which is a trading name someone typed for a
  // booking page — an invoice has to name the entity being billed, and
  // a tax invoice has to carry its address. Blank until the first
  // checkout; invoicing refuses rather than guessing.
  billingName    String @default("")
  billingAddress String @default("")

  providerCustomerId     String?
  providerSubscriptionId String? @unique

  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  /// How this subscription is actually being paid, cached from the
  /// provider so the Billing page costs no round trip to render.
  ///
  /// Refreshed when a charge webhook lands, because the instrument can
  /// change without us — a card replaced on expiry, a UPI mandate moved
  /// to another app. Blank until the first payment clears, which is an
  /// ordinary state: a mandate can be authorised and not yet charged.
  ///
  /// Display only, and never the full instrument. "Visa ending 4526",
  /// "UPI · priya@okhdfcbank", "PayPal · priya@example.com".
  paymentMethodKind  String @default("")
  paymentMethodLabel String @default("")

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trialEndsAt])
}

// Admin overrides — the early-access / comp / beta mechanism (§W8), and
// what replaces the five ENABLE_* env booleans Phase 1 deleted. Strictly
// better than those were: per account instead of per deploy, changeable
// from the admin console without a redeploy.
//
// Resolution is: plan defaults ∪ admin grants − admin revokes.
model Entitlement {
  id           String @id @default(cuid())
  connectionId String

  // A feature key ("waitlist") or a limit key ("limit.resources").
  key   String
  // "on" | "off" for a feature; a numeric cap (or "unlimited") for a limit.
  value String

  grantedByUserId String
  // Required, at the schema level. It costs five seconds to type and it
  // is the difference between an audit trail and a pile of magic strings
  // nobody can explain six months later.
  reason          String

  // Null means permanent.
  expiresAt DateTime?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, key])
  @@index([connectionId])
  @@index([expiresAt])
}

// Raw provider webhook payloads, for replay and for answering "they say
// they paid". Kept verbatim: whatever normalisation the code does at the
// edge, the thing a dispute is settled against has to be what the
// provider actually sent.
//
// `providerEventId` is unique, which is what makes webhook delivery
// idempotent — both providers retry, and a duplicate delivery must not
// double-apply.
model BillingEvent {
  id           String  @id @default(cuid())
  connectionId String?

  provider        String // paypal|razorpay
  providerEventId String @unique
  // Our own normalised event type, never a vendor string — the rest of
  // the codebase must never see a provider payload shape.
  type            String

  payload     String // raw JSON as delivered
  // Null until handled; set when the event has been applied, so a replay
  // can tell "received but not processed" from "already done".
  processedAt DateTime?
  error       String?

  createdAt  DateTime    @default(now())
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([provider, type])
  @@index([processedAt])
}

// Every platform-admin action, written in the same transaction as the
// change it describes. Handing out discounts and free plans without an
// immutable record of who did what is how a small team ends up unable to
// answer "why is this account free?"
model AdminAuditLog {
  id          String @id @default(cuid())
  actorUserId String

  action     String // "plan.change" | "trial.extend" | "entitlement.grant" | ...
  targetType String // "connection" | "user"
  targetId   String

  // JSON snapshots, both nullable — a grant has no `before`.
  before String?
  after  String?

  reason String
  ip     String @default("")

  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// One row per lifecycle email we have decided to send to an account —
/// welcome, first booking, trial nudges. Exists purely so each of them
/// is sent exactly once.
///
/// The unique index is the guard, not application logic: the trial
/// sweep runs every ten minutes and would otherwise re-send "your trial
/// ends in 3 days" every ten minutes for three days. The row is claimed
/// *before* the send and deleted again if the send throws, so a crashed
/// send is retried by the next sweep rather than silently swallowed.
model LifecycleEmail {
  id           String   @id @default(cuid())
  connectionId String
  /// welcome|first_booking|trial_ending|trial_ended — see core/src/lifecycle.ts.
  /// Not an enum, for the same reason plan isn't: adding a touch should
  /// not need a migration.
  kind         String
  sentAt       DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind])
  @@index([kind])
}

/// A tax invoice that has been issued. One row per payment taken.
///
/// Every field is a **snapshot**, including our own name, address and
/// GSTIN. That is not redundancy: an invoice is a legal document that
/// must continue to say what it said on the day it was issued, and
/// rendering one from today's configuration would silently rewrite
/// history the first time the company moves office or the price
/// changes. Nothing here is ever updated after insert.
model Invoice {
  id           String @id @default(cuid())
  connectionId String

  /// The full human-readable number, e.g. "GB/2026-27/0001". Unique
  /// across the system — India requires a consecutive series, and a
  /// duplicate is the kind of thing an auditor opens with.
  number   String   @unique
  /// The series this number was drawn from, e.g. "GB/2026-27".
  series   String
  issuedAt DateTime @default(now())

  // --- Seller, as it stood when this was issued ------------------
  sellerName    String
  sellerAddress String
  sellerGstin   String @default("")
  sellerCountry String @default("IN")

  // --- Buyer -----------------------------------------------------
  buyerName    String
  buyerAddress String @default("")
  buyerEmail   String
  buyerTaxId   String @default("")
  buyerCountry String @default("")

  /// india_gst|export_zero_rated — see core/src/billing/tax.ts.
  taxStatus String
  /// The declaration this invoice carries. Frozen with the rest.
  taxNote   String @default("")

  currency       String
  /// Minor units, like every other amount in the billing code.
  amountMinor    Int
  taxAmountMinor Int    @default(0)

  planId       String
  billingCycle String
  periodStart  DateTime?
  periodEnd    DateTime?

  provider          String
  /// The payment this invoices. Unique, and that uniqueness is the
  /// idempotency guard: a webhook redelivery, a reconciliation running
  /// beside it, and a manual replay all try to insert the same payment
  /// id, and exactly one wins. Nobody is ever invoiced twice for one
  /// charge.
  providerPaymentId String? @unique
  providerInvoiceId String?

  createdAt  DateTime   @default(now())
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, issuedAt])
}

/// The next number in each invoice series.
///
/// A separate table rather than a Postgres sequence because the series
/// resets every Indian financial year and the reset has to be visible
/// and auditable, not an implementation detail of a sequence object.
/// Handed out inside a transaction with the row locked — see
/// core/src/billing/invoiceNumber.ts.
model InvoiceCounter {
  series String @id
  next   Int    @default(1)

  updatedAt DateTime @updatedAt
}

/// A merchant's own WhatsApp Business Account, connected through Meta's
/// Embedded Signup.
///
/// The merchant owns the WABA and attaches their own payment method to
/// it, so Meta bills them directly and GetBooqin carries no per-message
/// cost. That is the whole reason this can be an ordinary plan feature
/// at ₹399/mo — a shared credit line would make every reminder our
/// cost, and the MVP plan ruled WhatsApp out on exactly that
/// arithmetic.
///
/// One per Connection: a WABA is tied to a phone number, and a phone
/// number is how a customer recognises the business.
model WhatsAppAccount {
  id                 String   @id @default(cuid())
  connectionId       String   @unique
  /// Meta's id for the WhatsApp Business Account.
  wabaId             String
  /// Meta's id for the phone number messages are sent from.
  phoneNumberId      String   @unique
  /// classic | coexistence — which Embedded Signup path the merchant
  /// actually took, which Meta decides inside its own popup rather than
  /// us deciding beforehand.
  ///
  /// It has to be stored because it changes what setup does: a
  /// coexistence number is *already* registered to the WhatsApp
  /// Business app, and calling /register on it is what would take the
  /// app away from the merchant. See whatsapp/accounts.ts.
  onboardingMode     String   @default("classic")
  /// "+91 98765 43210", as Meta formats it. Display only.
  displayPhoneNumber String   @default("")
  /// The business name Meta verified, which is what customers see.
  verifiedName       String   @default("")
  /// Encrypted at rest with CONNECTION_ENCRYPTION_KEY, exactly like
  /// Connection.credentials. A business integration system user token:
  /// long-lived, and scoped to this WABA alone.
  accessToken        String
  /// pending|active|revoked|error — `pending` is signup begun and phone
  /// not yet registered, which is a real state a merchant can sit in.
  status             String   @default("pending")
  /// Meta's own verdict on the number: GREEN|YELLOW|RED. A number that
  /// goes RED stops being able to send, so this is worth surfacing
  /// before it does rather than after.
  qualityRating      String?
  /// Unique customers reachable per 24h — TIER_250 upward.
  messagingLimit     String?
  /// The last send or API failure, for the Settings screen. Never a token.
  lastError          String?
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  connection Connection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  templates  WhatsAppTemplate[]
  messages   WhatsAppMessage[]

  @@index([wabaId])
}

/// A message template as Meta currently sees it.
///
/// Every proactive message WhatsApp allows is a template that Meta has
/// approved, and approval is per-WABA — the merchant's, not ours. So
/// this is a cache of *their* approval state, refreshed from the
/// template webhook, and it is what the send path checks before trying:
/// sending against a template Meta has since rejected or paused is a
/// failed send and a quality-rating hit, and we already know it will be.
model WhatsAppTemplate {
  id             String   @id @default(cuid())
  accountId      String
  /// Our catalogue key — "booking_confirmed". See whatsapp/templates.ts.
  key            String
  /// The name registered at Meta, which is the key prefixed and lowercased.
  name           String
  language       String   @default("en")
  /// APPROVED|PENDING|REJECTED|PAUSED|DISABLED — Meta's vocabulary, kept
  /// verbatim rather than mapped, so a new status can't silently read as
  /// sendable.
  status         String   @default("PENDING")
  category       String   @default("UTILITY")
  /// Why Meta rejected it, shown to the merchant so it can be fixed.
  rejectedReason String?
  updatedAt      DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name, language])
  @@index([accountId, key])
}

/// One outbound message, and what became of it.
///
/// Written before the send, not after, so a crash between the Graph
/// call and the row leaves evidence rather than silence. The delivery
/// status arrives later on the webhook and updates this row — which is
/// the only way to answer "did the customer actually get their
/// reminder", a question email cannot answer at all.
model WhatsAppMessage {
  id                String   @id @default(cuid())
  accountId         String
  /// Our template catalogue key.
  template          String
  /// E.164, as sent. Kept because a customer's number can change after.
  toPhone           String
  /// Meta's message id, once it has one. Null for a send that never left.
  providerMessageId String?  @unique
  /// queued|sent|delivered|read|failed
  status            String   @default("queued")
  errorCode         String?
  errorTitle        String?
  /// What this was about, for the booking's own timeline. Not a foreign
  /// key: a booking can be deleted and the record of having messaged
  /// someone should outlive it.
  bookingId         Int?
  waitlistId        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([bookingId])
}
