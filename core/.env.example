# core's own Postgres database — the system of record for the booking
# workflow. Separate from shopify-openslot's database; nothing is shared
# at the connection-string level.
DATABASE_URL="postgres://user:password@localhost:5432/getbooqin_core"

# 32-byte key (base64 or hex) used to encrypt Connection.credentials at
# rest. Generate with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=

# HMAC signing key for tenant session tokens issued by src/auth/session.ts.
# Generate with: openssl rand -hex 32
SESSION_SIGNING_SECRET=
