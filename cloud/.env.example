# Same Postgres database as core/ — this app is core's own signup/login +
# Shopify-connect front door, not a separate data store.
DATABASE_URL="postgres://user:password@localhost:5432/getbooqin_core"

# Must match core's values exactly — both read/write the same signed
# tokens and encrypted Connection.credentials.
CONNECTION_ENCRYPTION_KEY=
SESSION_SIGNING_SECRET=

# Clerk — cloud's user identity (see app/session.server.ts). From your
# Clerk application's dashboard (dashboard.clerk.com).
# Server-only: verifies sessions and calls Clerk's API. Never expose this.
# A sk_test_ value pairs with a development Clerk instance (see the note
# below) — swap both together, never just one.
CLERK_SECRET_KEY=
# Client-exposed — Vite only bundles env vars prefixed VITE_ into the
# browser build, which is required for ClerkProvider/useSignIn/useSignUp.
# pk_test_ (frontend API on *.clerk.accounts.dev) is a Clerk development
# instance: capped user count, relaxed security, shared/unbranded OAuth
# consent screens, and email delivery that doesn't match production. Fine
# for local dev, but any environment real customers can reach — including
# a "just deployed" box — needs a pk_live_ key from a production Clerk
# instance with your own domain and OAuth credentials instead.
VITE_CLERK_PUBLISHABLE_KEY=
# Signing secret for Clerk's webhooks (app/routes/webhooks.clerk.tsx),
# from Clerk Dashboard > Webhooks > your endpoint. Register
# ${APP_URL}/webhooks/clerk there, subscribed to user.created/user.updated.
CLERK_WEBHOOK_SIGNING_SECRET=

# This app's own base URL (used to build the Shopify OAuth redirect_uri).
# The Partner Dashboard must allow-list ${APP_URL}/connect/shopify/callback
# as a redirect URL on the SAME Shopify app shopify-openslot uses.
APP_URL="http://localhost:3100"

# Same Shopify app registration shopify-openslot's embedded admin uses
# (app/shopify.server.ts) — this is a second, non-embedded front door onto
# that one app, not a separate Shopify app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=

# Error monitoring (Phase 0's B4) — see server/instrument.js. In
# production both apps run in one process off one DSN; this is here for
# running cloud standalone in development. Inert while unset.
SENTRY_DSN=

# --- Billing (§W7) ---------------------------------------------------
# Nothing below is needed until the payment rail goes in (Phase 2c). With
# these unset, every account still gets its 30-day trial and every plan
# limit is still enforced — there is simply no way to upgrade, which is
# the correct state for 2a.
#
# Who may reach /admin. Layered with User.isPlatformAdmin: BOTH are
# required, so a leaked session or a bad write to one column isn't
# enough on its own. This var is what bootstraps the very first admin.
# Comma-separated.
PLATFORM_ADMIN_EMAILS=

# Razorpay carries all three currencies. INR runs on the domestic rails
# (UPI AutoPay, card e-mandate, NACH); USD and EUR need **International
# Payments activated** on the account, which is a separate approval.
# Razorpay requires an Indian registered entity with KYC and a domestic
# bank account — there is no way around that.
#
# PayPal is deliberately not here. It was in the original plan as the
# non-India rail, but its fixed $0.49 per charge is ~10 points of a $5
# subscription where Razorpay international is a flat ~3% with no fixed
# component. It stays a later iteration; core/src/billing/plans.ts's
# providerForCurrency() is the single line that changes when it lands.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Plan ids are NOT env vars — they live in core/src/billing/plans.ts,
# committed next to the amount each one charges. A Razorpay plan id is an
# opaque reference, not a credential, and twelve environment variables for
# non-secret data that changes twice a year bought nothing but the ability
# to half-configure a deploy. Test vs live is chosen from RAZORPAY_KEY_ID's
# own prefix (rzp_test_ / rzp_live_), so there is no mode variable to drift
# out of step with the keys either.

