# Generated from core/src/env.ts, which is the single source of truth and
# is checked at every boot. If you add a variable there, regenerate this.
#
# Required: the server refuses to start without these.
# Optional: the server starts and the named capability is switched off.

# ---------------------------------------------------------------- Required

# Postgres connection string
DATABASE_URL=

# Public origin, used in every emailed link
APP_URL=

# Signs the public booking-management links
SESSION_SIGNING_SECRET=

# Encrypts stored platform credentials at rest
CONNECTION_ENCRYPTION_KEY=

# Server-side authentication
CLERK_SECRET_KEY=

# Compiled into the client bundle at build time — see fly.toml's [build.args]
VITE_CLERK_PUBLISHABLE_KEY=

# ------------------------------------- Optional (each turns something off)

# Without this: email — no confirmations, reminders, invoices, trial nudges or team invites
# Outbound mail relay
SMTP_HOST=

# Without this: email — the relay will refuse to send without credentials
# SMTP authentication
SMTP_USER=

# SMTP authentication
SMTP_PASS=

# Without this: email deliverability — mail would be sent as the merchant's own domain and fail SPF/DKIM
# The authenticated From address
MAIL_FROM_EMAIL=

# Without this: Shopify — the app cannot be installed on a store
# Shopify app credentials
SHOPIFY_API_KEY=

# Shopify app credentials
SHOPIFY_API_SECRET=

# Shopify OAuth scopes
SCOPES=

# Without this: Shopify OAuth — an install would be redirected back to the wrong host
# Shopify OAuth callback origin, which must match the Partner dashboard
SHOPIFY_APP_URL=

# Without this: the Razorpay rail — Indian merchants cannot subscribe
# Razorpay API credentials
RAZORPAY_KEY_ID=

# Without this: the connected-gateway rail — a booking deposit can still be collected over UPI, but nothing can confirm the booking automatically
# Razorpay Technology Partner OAuth client, for merchants taking booking payments on their own account
RAZORPAY_PARTNER_CLIENT_ID=

# Razorpay Technology Partner OAuth client secret
RAZORPAY_PARTNER_CLIENT_SECRET=

# Razorpay API credentials
RAZORPAY_KEY_SECRET=

# Without this: Razorpay renewals and failures — money could be taken with nothing to record it
# Verifies Razorpay webhook deliveries
RAZORPAY_WEBHOOK_SECRET=

# Without this: the PayPal rail — merchants outside India cannot subscribe
# PayPal API credentials
PAYPAL_CLIENT_ID=

# PayPal API credentials
PAYPAL_CLIENT_SECRET=

# Without this: PayPal renewals and failures — money could be taken with nothing to record it
# Verifies PayPal webhook deliveries
PAYPAL_WEBHOOK_ID=

# Without this: invoicing — payments are taken and no invoice is issued
# The entity issuing invoices
INVOICE_LEGAL_NAME=

# The registered address printed on invoices
INVOICE_ADDRESS=

# Without this: WhatsApp — merchants cannot connect a WhatsApp Business account
# Meta app credentials, for WhatsApp Embedded Signup
META_APP_ID=

# Meta app credentials, and verifies every WhatsApp webhook
META_APP_SECRET=

# The Embedded Signup configuration the merchant's popup opens
META_WHATSAPP_CONFIG_ID=

# Without this: WhatsApp deliveries — message status, replies and template approvals never arrive
# Answers Meta's one-time webhook verification handshake
META_WEBHOOK_VERIFY_TOKEN=

# Without this: user sync — signups never reach our own User table
# Verifies Clerk webhook deliveries
CLERK_WEBHOOK_SIGNING_SECRET=

# Without this: the admin console — nobody can reach /admin, including you
# Allowlist for the platform admin console
PLATFORM_ADMIN_EMAILS=

# Without this: external cron triggers — /cron/* refuses every call (the in-process sweep still runs)
# Bearer token for the external cron endpoints
CRON_SECRET=

# Without this: error reporting — failures are only visible in logs
# Error reporting
SENTRY_DSN=

# Without this: the support address shown in the Shopify app footer
# Shown to merchants as the contact address
SUPPORT_EMAIL=

# ------------------------------------------------- Invoicing, optional bits

# GSTIN printed on invoices. Blank is legitimate below the registration threshold.
INVOICE_GSTIN=

# 'true' once a Letter of Undertaking is on file — decides whether export
# invoices go out under LUT without IGST, or with IGST payable.
INVOICE_LUT_ON_FILE=false

# Invoice series prefix: GB -> GB/2026-27/0001
INVOICE_SERIES_PREFIX=GB

# GST rate for domestic Indian sales, as a percentage.
INVOICE_GST_RATE=18

# sandbox | live. PayPal credentials look identical in both, so this is explicit.
PAYPAL_ENV=sandbox
