# Filled in automatically by `shopify app dev` / `shopify app deploy`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# prisma/schema.prisma is pointed at Postgres. Production uses the Fly
# Postgres cluster (openslot-shelfscore-db) via the DATABASE_URL secret set
# by `fly postgres attach`. For local dev, tunnel to that same cluster:
#   fly proxy 5432 -a openslot-shelfscore-db
# then point this at it (see .env for the actual connection string) — or
# run your own local Postgres and use its connection string instead.
DATABASE_URL="postgres://user:password@localhost:5432/openslot"

# Shared secret /cron/reminders requires as `Authorization: Bearer
# <value>`. Generate with `openssl rand -hex 32`.
#
# Nothing is scheduled against that route today — the reminder sweep runs
# in-process every 10 minutes (server/combined.js), and external
# monitoring comes from /healthz?strict=1, which needs no secret. This is
# for triggering a sweep by hand, and for whatever scheduler gets pointed
# at the route later. An unset value here does not stop reminders.
CRON_SECRET=

# Outbound transactional email (booking confirmations, reminders, chat leads).
# Any SMTP account works — Postmark, SES, Resend's SMTP endpoint, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The one address everything is sent FROM, on a domain you control and
# have set up SPF + DKIM + DMARC for. NOT the merchant's address: sending
# as a domain this relay isn't authorised for fails SPF/DKIM alignment and
# gets the mail spam-foldered or rejected, which is what used to happen
# (Phase 0's B3 — see core/src/booking/mailer.ts's fromHeaders()).
#
# With this set, messages go out as
#   From: "Merchant's Business Name via GetBooqin" <MAIL_FROM_EMAIL>
#   Reply-To: <the merchant's own address>
# Leave it blank ONLY in local development; the mailer warns at startup.
MAIL_FROM_EMAIL=
# The "via …" half of that display name. Defaults to "GetBooqin".
MAIL_FROM_NAME=

# Error monitoring (Phase 0's B4) — from sentry.io, Project Settings >
# Client Keys (DSN). Everything Sentry-related is completely inert while
# this is unset, so it's safe to leave blank. See server/instrument.js.
SENTRY_DSN=
# Defaults to NODE_ENV. Set explicitly if you run more than one deployed
# environment off the same Sentry project.
SENTRY_ENVIRONMENT=
# Performance tracing, 0–1. Off by default: on a $5/month product the
# tracing quota is the first thing to run out. Turn it on deliberately.
SENTRY_TRACES_SAMPLE_RATE=0

# Shown on the public /privacy page (required in the Partner Dashboard
# listing as the app's privacy_policy_url) and as the "contact us" address
# for data requests. Falls back to MAIL_FROM_EMAIL if unset.
SUPPORT_EMAIL=
