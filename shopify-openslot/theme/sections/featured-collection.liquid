<section class="collection-strip">
  <div class="collection-strip__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="collection-strip__view-all">View all</a>
    {% endif %}
  </div>

  {% if section.settings.collection != blank %}
    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="collection-strip__empty">Select a collection to display products here.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take-home essentials" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
