<section class="testimonials">
  <div class="testimonials__header">
    {% if section.settings.eyebrow != blank %}
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="testimonials__grid">
    {% for block in section.blocks %}
      <blockquote class="testimonial-card" {{ block.shopify_attributes }}>
        <div class="testimonial-card__stars" aria-hidden="true">
          {% for i in (1..5) %}★{% endfor %}
        </div>
        <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <cite class="testimonial-card__author">{{ block.settings.author }}</cite>
      </blockquote>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by regulars" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The most relaxing manicure I've had — and my gel lasted three full weeks." },
        { "type": "text", "id": "author", "label": "Author", "default": "Amara T." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "Booking online took thirty seconds and they text you a reminder. Love it.", "author": "Priya S." } },
        { "type": "testimonial", "settings": { "quote": "Clean, calm, and my nail tech actually listens to what I want.", "author": "Devon M." } }
      ]
    }
  ]
}
{% endschema %}
