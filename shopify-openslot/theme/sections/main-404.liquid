<section class="error-page">
  <p class="section-eyebrow">404</p>
  <h1 class="error-page__title">{{ section.settings.heading }}</h1>
  <p class="error-page__text">{{ section.settings.text }}</p>
  <a href="{{ routes.root_url }}" class="button button--accent">{{ section.settings.button_text }}</a>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page took a day off" },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you're looking for doesn't exist. Let's get you back to something pretty." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Back to the studio" }
  ]
}
{% endschema %}
