<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">{{ shop.name }}</span>
      {% if section.settings.tagline != blank %}
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
      {% if section.settings.booking_page_link != blank %}
        <a href="{{ section.settings.booking_page_link }}" class="site-footer__manage-link">Book or manage an appointment &rarr;</a>
      {% endif %}
      <div class="site-footer__social">
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon-instagram' %}</a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon-tiktok' %}</a>
        {% endif %}
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon-facebook' %}</a>
        {% endif %}
      </div>
    </div>

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'menu' %}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% when 'text' %}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <div class="site-footer__text">{{ block.settings.text }}</div>
          </div>
      {% endcase %}
    {% endfor %}

    <div class="site-footer__col site-footer__newsletter">
      <h3>{{ section.settings.newsletter_heading }}</h3>
      <p>{{ section.settings.newsletter_text }}</p>
      {% form 'customer', class: 'newsletter-form' %}
        {% if form.posted_successfully? %}
          <p class="newsletter-form__success">You're on the list.</p>
        {% else %}
          <div class="newsletter-form__row">
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="footer-email">Email</label>
            <input type="email" id="footer-email" name="contact[email]" placeholder="Your email" required>
            <button type="submit" class="button button--accent">Join</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <p class="site-footer__powered">Booking by GetBooqin</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Nails, done beautifully." },
    { "type": "url", "id": "booking_page_link", "label": "Booking page link", "info": "Shown as a link under the shop name so customers can always find their way to book or manage an appointment." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Stay polished" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New shades, seasonal offers and appointment openings — straight to your inbox." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Studio" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>123 Studio Lane<br>Open Tue–Sat, 10am–7pm</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "text" }
    ]
  }
}
{% endschema %}
