<section class="service-grid">
  <div class="service-grid__header">
    {% if section.settings.eyebrow != blank %}
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="service-grid__items">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.collection.url | default: block.settings.link | default: '#' }}"
        class="service-card"
        {{ block.shopify_attributes }}
      >
        <div class="service-card__media">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt=""
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {% elsif block.settings.collection.featured_image %}
            <img
              src="{{ block.settings.collection.featured_image | image_url: width: 800 }}"
              alt=""
              width="{{ block.settings.collection.featured_image.width }}"
              height="{{ block.settings.collection.featured_image.height }}"
              loading="lazy"
            >
          {% else %}
            {%- comment -%}
              No merchant photo yet — show a themed line-art illustration
              instead of an empty box, so the grid reads as designed rather
              than unfinished until real photos are uploaded.
            {%- endcomment -%}
            <div class="service-card__placeholder">
              {% case block.settings.icon %}
                {% when 'pedicure' %}{% render 'illustration-pedicure', class: 'service-card__icon' %}
                {% when 'gel' %}{% render 'illustration-gel', class: 'service-card__icon' %}
                {% when 'nail-art' %}{% render 'illustration-nail-art', class: 'service-card__icon' %}
                {% else %}{% render 'illustration-manicure', class: 'service-card__icon' %}
              {% endcase %}
            </div>
          {% endif %}
        </div>
        <h3 class="service-card__title">{{ block.settings.title | default: block.settings.collection.title }}</h3>
        {% if block.settings.subtitle != blank %}
          <p class="service-card__subtitle">{{ block.settings.subtitle }}</p>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Service categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our menu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your service" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional — falls back to collection image, then a themed icon)" },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon (used until you add a photo)",
          "default": "manicure",
          "options": [
            { "value": "manicure", "label": "Manicure" },
            { "value": "pedicure", "label": "Pedicure" },
            { "value": "gel", "label": "Gel & extensions" },
            { "value": "nail-art", "label": "Nail art" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "from $45" },
        { "type": "url", "id": "link", "label": "Link (used if no collection is chosen)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service categories",
      "blocks": [
        { "type": "service", "settings": { "title": "Manicure", "subtitle": "from $35", "icon": "manicure" } },
        { "type": "service", "settings": { "title": "Pedicure", "subtitle": "from $45", "icon": "pedicure" } },
        { "type": "service", "settings": { "title": "Gel & Extensions", "subtitle": "from $65", "icon": "gel" } },
        { "type": "service", "settings": { "title": "Nail Art", "subtitle": "from $10", "icon": "nail-art" } }
      ]
    }
  ]
}
{% endschema %}
