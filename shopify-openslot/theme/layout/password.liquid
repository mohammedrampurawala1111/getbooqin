<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}

    :root {
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-text: {{ settings.color_accent_text }};
      --color-border: {{ settings.color_border }};
      --font-heading: {{ settings.font_heading.family }}, serif;
      --font-heading-weight: {{ settings.font_heading.weight }};
      --font-body: {{ settings.font_body.family }}, sans-serif;
      --radius: {{ settings.corner_radius }}px;
    }
  </style>
  {{ content_for_header }}
</head>
<body class="password-page">
  <div class="password-page__wrap">
    <h1 class="password-page__title">{{ shop.name }}</h1>
    <p class="password-page__intro">We're putting the finishing touches on the studio. Enter the password below to take a peek.</p>

    {{ content_for_layout }}

    {% if shop.email %}
      <p class="password-page__contact">Questions? <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
    {% endif %}
  </div>
</body>
</html>
